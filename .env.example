APP_ENV=development
LISTEN_ADDR=:8080
# Bootstrap role: migrate only (DDL + role administration). Never point the API here.
DATABASE_URL=postgres://nexus:nexus_local_only@localhost:5432/nexus?sslmode=disable
REDIS_URL=redis://localhost:6379/0
# Generate independent 32+ character random secrets before sharing any deployment.
JWT_SECRET=development_jwt_secret_replace_32_chars
DATA_KEY=development_data_key_replace_32_chars
OTP_SECRET=development_otp_key_replace_32_chars
# Operational role passwords (created NOLOGIN; cmd/migrate fails closed if unset).
# Must be distinct, 16+ characters. Local-only values shown; replace for any shared env.
NEXUS_APP_DB_PASSWORD=nexus_app_local_only_pw
NEXUS_MODERATOR_DB_PASSWORD=nexus_mod_local_only_pw1
NEXUS_JANITOR_DB_PASSWORD=nexus_jan_local_only_pw2
# No SMS in local development. OTP appears only in development API response.
SMS_URL=
SMS_TOKEN=
ALLOWED_ORIGIN=http://localhost:3000
