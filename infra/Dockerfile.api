FROM golang:1.25.5-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
RUN CGO_ENABLED=0 go build -trimpath -o /api ./cmd/api && CGO_ENABLED=0 go build -trimpath -o /migrate ./cmd/migrate && CGO_ENABLED=0 go build -trimpath -o /janitor ./cmd/janitor && CGO_ENABLED=0 go build -trimpath -o /moderate ./cmd/moderate && CGO_ENABLED=0 go build -trimpath -o /purge ./cmd/purge
FROM gcr.io/distroless/static-debian12:nonroot
WORKDIR /app
COPY --from=build /api /app/api
COPY --from=build /migrate /app/migrate
COPY --from=build /janitor /app/janitor
COPY --from=build /moderate /app/moderate
COPY --from=build /purge /app/purge
COPY db /app/db
USER nonroot:nonroot
EXPOSE 8080
ENTRYPOINT ["/app/api"]
